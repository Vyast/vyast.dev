  <div class="my-6">
    <div class="text-4xl">👋</div>

    <ul class="py-6 list-disc list-inside">
      <li>23</li>
      <li>CS Student</li>
      <li>
        Current Projects: <ul class="list-disc list-inside pl-6 py-1">
          <li>
            <a
              href="https://github.com/tmf-cfx"
              target="_blank"
              rel="noreferrer noopener"
              class="hover:underline underline-offset-2 text-white/80 leading-8 sm:leading-none"
            >
              TMFRP
            </a>
          </li>

          <li>
            <a
              href="https://github.com/n4-gg"
              target="_blank"
              rel="noreferrer noopener"
              class="hover:underline underline-offset-4 text-white/80 leading-8 sm:leading-none"
            >
              n4.gg
            </a>
          </li>
        </ul>
      </li>
      <li>
        Legacy Projects: <ul class="list-disc list-inside pl-6 py-1">
          <li>
            <a
              href="https://github.com/venom-ac"
              target="_blank"
              rel="noreferrer noopener"
              class="hover:underline underline-offset-2 text-white/80 leading-8 sm:leading-none"
